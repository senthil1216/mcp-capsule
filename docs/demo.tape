# Capsule demo — reproducible terminal recording (render with `make demo-gif`).
#
# This .tape file describes the same 8-step walkthrough as docs/demo.sh but in a
# form vhs can replay deterministically. Output is docs/capsule-demo.gif.
#
# Why a tape (not a one-shot asciinema rec): the benchmark numbers in
# bench/REPORT.md are generated, not hand-typed; the demo should be the same. If
# the code or the report changes, `make demo-gif` produces a fresh, matching GIF.
#
# Prereqs (one-time):
#   brew install vhs
#   pip install -e ".[dev,mcp,sandbox]"
#   make sandbox-image        # only if you want the run_command sandbox steps live

Output "docs/capsule-demo.gif"

# --- visual style ---
Set FontSize 14
Set Width 1200
Set Height 700
Set Padding 20
Set Theme "Dracula"
Set TypingSpeed 12ms

# hide the setup noise
Hide
Type "cd /Users/senthil.sivasubramanian/workspace/mcp-capsule"
Enter
Type "source .venv/bin/activate 2>/dev/null || true"
Enter
Sleep 500ms
Show

# ===== 1. The problem: a repo README carrying a prompt injection =====
Type "echo '1. The problem: a repo README carrying a prompt injection'"
Enter
Sleep 500ms
Type "sed -n '1,18p' examples/malicious-repo/README.md"
Enter
Sleep 1200ms

# ===== 2. Unsafe baseline: no gateway, secrets reachable =====
Type "echo '2. Unsafe baseline (no gateway): honeytokens are reached'"
Enter
Sleep 500ms
Type "python -m bench.runner --mode unsafe --attacks read_host_ssh_key,curl_exfiltration"
Enter
Sleep 2500ms

# ===== 3. The same attacks through Capsule =====
Type "echo '3. Same attacks through Capsule (one MCP session, taint persists)'"
Enter
Sleep 500ms
Type "python -m demo.injection_demo"
Enter
Sleep 3500ms

# ===== 4. Approval is out-of-band and can be denied =====
Type "echo '4. Approval is out-of-band; release or deny via capsule-approve'"
Enter
Sleep 500ms
Type "capsule-approve list"
Enter
Sleep 1200ms

# ===== 5. The measured report (generated, not hand-typed) =====
Type "echo '5. Measured report — generated by make bench, not hand-typed'"
Enter
Sleep 500ms
Type "sed -n '9,20p' bench/REPORT.md"
Enter
Sleep 1500ms

# ===== 6. Structured audit trail =====
Type "echo '6. Audit trail — one structured event per decision'"
Enter
Sleep 500ms
Type "tail -n 5 audit.log | python -m json.tool --no-ensure-ascii 2>/dev/null || tail -n 5 audit.log"
Enter
Sleep 1500ms

Type "echo 'Capsule: sandbox the call, track what leaves.'"
Enter
Sleep 1s
